PORT=3000
HOST=127.0.0.1
UPLOAD_DIR=/mnt/asus-nas/uploads
MAX_FILE_SIZE=20971520
# Generate with: openssl rand -base64 48
UPLOAD_TOKEN=GANTI_DENGAN_TOKEN_RANDOM_MINIMAL_32_BYTE
MAX_CONCURRENT_UPLOADS=8
# Sisakan minimal 1 GiB ruang kosong pada volume NAS
MIN_FREE_DISK_BYTES=1073741824
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=1 minute
LOG_LEVEL=info
